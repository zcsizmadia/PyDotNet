<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(DefaultTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>PyDotNet.Extensions.Hosting.Tests</RootNamespace>
    <AssemblyName>PyDotNet.Extensions.Hosting.Tests</AssemblyName>
    <!-- TUnit requires EnforceCodeStyleInBuild to not be set to avoid
         false positives in generated code. -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- Disable XML doc warnings and underscore naming rule (test convention). -->
    <NoWarn>$(NoWarn);CS1591;CA1707;TUnitAssertions0005</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="TUnit" />

    <!-- The full hosting package, not just the abstractions the library targets: these
         tests build a real host and start it. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/PyDotNet.Extensions.Hosting/PyDotNet.Extensions.Hosting.csproj" />
  </ItemGroup>

</Project>
