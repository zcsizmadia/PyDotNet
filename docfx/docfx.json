{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "PyDotNet/PyDotNet.csproj",
            "PyDotNet.NumPy/PyDotNet.NumPy.csproj",
            "PyDotNet.DataFrames/PyDotNet.DataFrames.csproj",
            "PyDotNet.Torch/PyDotNet.Torch.csproj",
            "PyDotNet.Matplotlib/PyDotNet.Matplotlib.csproj"
          ]
        }
      ],
      "dest": "api",
      "outputFormat": "apiPage",
      "properties": {
        "TargetFramework": "net10.0",
        "Configuration": "Release"
      },
      "enumSortOrder": "declaringOrder"
    }
  ],
  "build": {
    "content": [
      {
        "files": [ "index.md", "toc.yml" ]
      },
      {
        "src": "apidoc",
        "files": [ "index.md" ],
        "dest": "api"
      },
      {
        "src": "api",
        "files": [ "**.yml", "**.md" ],
        "dest": "api"
      },
      {
        "src": "../docs",
        "files": [ "**.md", "toc.yml" ],
        "dest": "guides"
      }
    ],
    "output": "_site",
    "template": [ "default", "modern" ],
    "globalMetadata": {
      "_appName": "PyDotNet",
      "_appTitle": "PyDotNet",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/zcsizmadia/PyDotNet",
        "branch": "main"
      },
      "pdf": false
    },
    "sitemap": {
      "baseUrl": "https://zcsizmadia.github.io/PyDotNet/",
      "priority": 0.5,
      "changefreq": "weekly"
    }
  }
}
