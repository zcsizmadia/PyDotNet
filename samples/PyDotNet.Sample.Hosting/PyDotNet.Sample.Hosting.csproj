<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>PyDotNet.Sample.Hosting</RootNamespace>
    <AssemblyName>PyDotNet.Sample.Hosting</AssemblyName>
    <Description>Wiring PyDotNet into a Microsoft.Extensions.Hosting application.</Description>
    <!-- Samples are not production code — relax some warnings. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/PyDotNet.Extensions.Hosting/PyDotNet.Extensions.Hosting.csproj" />
  </ItemGroup>

</Project>
